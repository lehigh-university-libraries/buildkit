{{ end -}}
{{ end -}}
];

$databases['default']['default'] = [
  'database' => '{{ template "sqlEscape" $dbName }}',
  'username' => '{{ template "sqlEscape" $dbUser }}',
  'password' => '{{ template "sqlEscape" $dbPassword }}',
  'host' => '{{ template "sqlEscape" $dbHost }}',
  'port' => '{{ template "sqlEscape" $dbPort }}',
  'prefix' => '',
  'driver' => 'mysql',
  'namespace' => 'Drupal\\Core\\Database\\Driver\\mysql',
];

$config['search_api.server.default_solr_server']['backend_config']['connector_config']['host'] = '{{ template "sqlEscape" $solrHost }}';
