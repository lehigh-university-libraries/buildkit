{{ $smtpPort := getenv "LIBOPS_SMTP_PORT" }}
{{ $ingressHostnames := replace (getenv "INGRESS_HOSTNAMES") " " "" -1 }}
$settings['hash_salt'] = '{{ template "sqlEscape" $hashSalt }}';
