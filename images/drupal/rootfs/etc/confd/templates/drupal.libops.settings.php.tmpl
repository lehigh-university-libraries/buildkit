$config['search_api.server.default_solr_server']['backend_config']['connector_config']['core'] = '{{ template "sqlEscape" $solrCore }}';

$config['system.mail']['interface']['default'] = 'symfony_mailer';
$config['system.mail']['mailer_dsn'] = [
  'scheme' => 'smtp',
  'host' => '{{ template "sqlEscape" $smtpHost }}',
  'user' => NULL,
  'password' => NULL,
  'port' => (int) '{{ $smtpPort }}',
  'options' => [],
];

{{ if ne (getenv "DRUPAL_DEFAULT_BROKER_URL") "" -}}
{{ $brokerURL := getenv "DRUPAL_DEFAULT_BROKER_URL" }}
{{ $brokerUser := getenv "DRUPAL_DEFAULT_BROKER_USER" }}
{{ $brokerPassword := getenv "DRUPAL_DEFAULT_BROKER_PASSWORD" }}
$config['islandora.settings']['broker_url'] = '{{ template "sqlEscape" $brokerURL }}';
