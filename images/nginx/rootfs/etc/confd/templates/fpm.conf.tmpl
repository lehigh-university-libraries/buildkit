# Reserved base-image endpoint; application document roots and regex routes do not apply.
include /etc/nginx/shared/google-site-verification.conf;

# Used to validate that PHP-FPM is in a ready state.
# Not accessible outside of the container.
location ~ ^/(status|ping)$ {
    access_log off;
    allow 127.0.0.1;
    allow ::1;
    deny all;
    fastcgi_param SCRIPT_FILENAME $document_root$fastcgi_script_name;
    fastcgi_index index.php;
    include fastcgi_params;
    fastcgi_pass unix:{{ getenv "PHP_FPM_SOCKET" }};
}
