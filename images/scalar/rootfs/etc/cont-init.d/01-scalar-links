#!/command/with-contenv bash
# shellcheck shell=bash
set -euo pipefail

# /opt/scalar is the persistent book-data directory. Never replace pre-existing
# files: an old whole-webroot migration needs an explicit operator review.
for name in system codeigniter.php maintenance.html; do
  target="/usr/local/share/scalar/$name"
  link="/opt/scalar/$name"
  if [[ -L $link && $(readlink "$link") == "$target" ]]; then
    continue
  fi
  if [[ -e $link || -L $link ]]; then
    echo "Refusing to replace $link; move legacy application files out of the book-data directory after backing them up." >&2
    exit 1
  fi
  ln -s "$target" "$link"
done
# Allow PHP-FPM to create books but not unlink the root-owned application links.
chown root:nginx /opt/scalar
chmod 1775 /opt/scalar
# Disposable application cache stays outside the immutable application code.
install -d -o nginx -g nginx -m 0750 /run/scalar/cache
